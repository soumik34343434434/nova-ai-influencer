APP_ENV=development
DATABASE_URL=sqlite:///./nova.db
MOCK_LLM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-mini
APPROVAL_REQUIRED=true
# Real platform publishing is unavailable by default; the outbox is review-only.
NOVA_ENABLE_REAL_PUBLISH=false
CHARACTER_IMAGE=assets/character/nova.png
NOVA_CHARACTER_IMAGE=assets/character/nova.png
NOVA_MOTION_PROVIDER=local
NOVA_MOTION_COMMAND=
OUTPUT_DIR=artifacts/videos

# NOVA intelligence connectors (optional; leave blank for free/public-source mode)
YOUTUBE_API_KEY=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=
TIKTOK_RESEARCH_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
TIKTOK_RESEARCH_REGION=IN
TIKTOK_RESEARCH_KEYWORDS=dance,meme,funny,cat,cartoon,reaction,pov,cute
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=v26.0
# n8n integration (local)
NOVA_API_TOKEN=
# Instagram trend research via Graph API hashtag search (needs Public Content Access)
INSTAGRAM_TREND_HASHTAGS=cartoon,animation,funnycats,catsofinstagram,robot,cutebirds,relatable,pov

# Cartoon factory
# Renderer: pillow (local, default), blender, or runway (hosted shots + local voice track)
NOVA_CARTOON_ANIMATION_BACKEND=pillow
# Visual QA -> Repair loop budget per run
NOVA_MAX_REPAIR_ATTEMPTS=2

# Runway (optional, spends credits; execution needs all of these)
# Quote a plan first, free: python -m app.providers.runway_video quote <plan.json>
RUNWAYML_API_SECRET=
NOVA_RUNWAY_EXECUTE=false
# Cap per episode, counting everything it already spent (repairs included)
NOVA_RUNWAY_MAX_CREDITS=0
# Cap per UTC day across all episodes (defaults to the episode cap)
NOVA_RUNWAY_DAILY_CREDITS=
# Regenerate failing shots on Runway after QA? Off = stop and report, spend nothing
NOVA_RUNWAY_PAID_REPAIRS=false
# Hosts generated clips download from (checked before spending)
NOVA_RUNWAY_DOWNLOAD_HOSTS=dnznrvs05pmza.cloudfront.net
# JSON map from NOVA model names to Runway API model ids, e.g. {"kling-3-standard":"..."}
NOVA_RUNWAY_MODEL_MAP=
# Voice: local (say/espeak) or runway; per-character voices live in config/character_voices.json
NOVA_VOICE_BACKEND=local
RUNWAY_AUDIO_CONFIG_ID=

# Live publishing (after `python -m app.publish_approved --approve`)
YOUTUBE_PRIVACY_STATUS=private
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
