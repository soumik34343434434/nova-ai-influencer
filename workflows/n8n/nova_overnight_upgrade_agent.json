[
  {
    "id": "nova-overnight-upgrade-agent",
    "name": "NOVA Overnight Upgrade Agent",
    "description": null,
    "active": false,
    "isArchived": false,
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "minutes",
                "minutesInterval": 15
              }
            ]
          }
        },
        "id": "nova-upgrade-schedule",
        "name": "15-Minute Upgrade Trigger",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          0,
          300
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://host.docker.internal:8787/action",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-NOVA-API-Key",
                "value": "={{$env.NOVA_API_TOKEN}}"
              }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ action: 'codex_cycle' }) }}",
          "options": {
            "timeout": 900000
          }
        },
        "id": "nova-codex-cycle",
        "name": "NOVA Codex Upgrade Cycle",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          420,
          300
        ]
      }
    ],
    "connections": {
      "15-Minute Upgrade Trigger": {
        "main": [
          [
            {
              "node": "NOVA Codex Upgrade Cycle",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1"
    },
    "staticData": null,
    "meta": null,
    "nodeGroups": [],
    "pinData": {},
    "sourceWorkflowId": null,
